    // Strong signs (taken from the SFC source)
    try { if (document.querySelector(".tp-statefarm")) add(3, "elements with class tp-statefarm"); } catch (e) { christmasLog.debug("detector", e); }
    try { if (typeof String.prototype.originalReplace === "function" || typeof String.prototype.originalReplaceAll === "function") add(3, "String.prototype.originalReplace patch"); } catch (e) { christmasLog.debug("detector", e); }
    try { if (window.WASMOBJECT) add(3, "window.WASMOBJECT (WebAssembly hook)"); } catch (e) { christmasLog.debug("detector", e); }
    try { if (window.globalSS) add(3, "window.globalSS (SFC debug object)"); } catch (e) { christmasLog.debug("detector", e); }
    try { if (document.getElementById("sfChat-iframe") || document.querySelector('iframe[src*="StateFarmClient" i]')) add(3, "SFC chat iframe"); } catch (e) { christmasLog.debug("detector", e); }
    try { if (document.getElementById("automated-border")) add(3, "SFC bot window border"); } catch (e) { christmasLog.debug("detector", e); }
    try { if (/state\s*farm/i.test(norm(document.title))) add(3, "page title mentions StateFarm"); } catch (e) { christmasLog.debug("detector", e); }
    try { if (document.querySelector('img[src*="StateFarmClient" i],img[src*="shell-logo-replacement" i],img[src*="sfc.best" i]')) add(3, "SFC logo / badge images"); } catch (e) { christmasLog.debug("detector", e); }

    // Medium signs (need to add up with something else)
    try { if (document.querySelector("#minimap.MiniMap") && document.querySelector(".playerDot")) add(2, "SFC minimap elements"); } catch (e) { christmasLog.debug("detector", e); }
    try {
      const scrambled = Object.getOwnPropertyNames(window).filter((k) => {
        if (!/^[a-z]{10}$/.test(k)) return false;
        try { return typeof window[k] === "function"; } catch (e) { return false; }
      });
      if (scrambled.length >= 5) add(2, `${scrambled.length} random 10-letter global functions`);
    } catch (e) { christmasLog.debug("detector", e); }
    try { if (document.querySelector(".tp-rotv")) add(1, "Tweakpane menu present"); } catch (e) { christmasLog.debug("detector", e); }
    try {
      if (window.WebAssembly && !isNative(WebAssembly.instantiateStreaming)) add(1, "WebAssembly.instantiateStreaming replaced");
      if (!isNative(EventTarget.prototype.addEventListener)) add(1, "addEventListener replaced");
      if (!isNative(HTMLElement.prototype.appendChild)) add(1, "appendChild replaced");
    } catch (e) { christmasLog.debug("detector", e); }

    return { score, reasons };
  }

  // ---------- 1b. Is a skin hack / skin unlocker running on this page? ----------
  // Strong signs lock the screen. Weak signs (patched network functions) only show a warning,
  // because ad blockers and other userscripts can patch those too.
  const SKIN_TOKENS = ["skinhack", "skin-hack", "skin_hack", "skinchanger", "skin-changer", "skin_changer", "skinunlock", "skin-unlock", "skin_unlock", "unlockskins", "unlock-skins", "unlock_skins"];
  const SKIN_SELECTOR = SKIN_TOKENS.map((t) => `[id*="${t}" i],[class*="${t}" i]`).join(",");
  const SKIN_GLOBALS = ["skinHack", "skinHacks", "SkinHack", "skinChanger", "SkinChanger", "skinUnlocker", "SkinUnlocker", "skinUnlock", "unlockSkins", "unlockAllSkins"];
  let skinWarned = false;

  function findSkinEvidence() {
    let score = 0, weak = 0;
    const reasons = [];
    const add = (pts, why) => { score += pts; reasons.push(why); };

    try { if (document.querySelector(SKIN_SELECTOR)) add(3, "skin hack elements in the page"); } catch (e) { christmasLog.debug("detector", e); }
    try {
      const g = SKIN_GLOBALS.filter((n) => { try { return typeof window[n] !== "undefined"; } catch (e) { return false; } });
      if (g.length) add(3, "skin hack globals: " + g.join(", "));
    } catch (e) { christmasLog.debug("detector", e); }
    try { if (/skin\s*(hack|changer|unlock)/i.test(norm(document.title))) add(3, "page title mentions a skin hack"); } catch (e) { christmasLog.debug("detector", e); }

    // Exact fingerprints of the "skin hax (All Skins & Weapons)" unlocker
    try {
      const ex = window.extern;
      if (skinLogSeen) add(3, "unlocker console message seen");
      if (ex && ex._isPatchedAllSkins) add(3, "extern._isPatchedAllSkins flag");
      if (ex) {
        const src = ["getItemsOfType", "isItemOwned", "selectItem"].map((n) => {
          try { return typeof ex[n] === "function" ? Function.prototype.toString.call(ex[n]) : ""; } catch (e) { return ""; }
        }).join("\n");
        if (/unlockItem|getRarityScore|_isPatchedAllSkins/.test(src)) add(3, "extern item functions contain unlocker code");
      }
      const d = Object.getOwnPropertyDescriptor(window, "extern");
      if (d && (d.get || d.set)) add(2, "window.extern replaced by a getter/setter trap");
      if (ex && typeof ex.isItemOwned === "function") {
        let r = false;
        try { r = ex.isItemOwned({ id: -987654, name: "__christmas_probe__" }) === true; } catch (e) { christmasLog.debug("detector", e); }
        if (r) add(2, "isItemOwned says yes to a fake item");
      }
      if (ex && Array.isArray(ex.items) && ex.items.length >= 20) {
        const hit = ex.items.filter((i) => i && i.owned === true && i.is_owned === true && i.vipOnly === false && i.exclusive === false && i.unlock === "default").length;
        if (hit >= ex.items.length * 0.8) add(3, "items carry the unlocker's owned/vipOnly/exclusive fields");
      }
    } catch (e) { christmasLog.debug("detector", e); }

    // Weak signs: network / JSON functions that skin unlockers replace to fake your inventory
    try {
      const patched = [
        ["fetch", window.fetch],
        ["XMLHttpRequest.open", XMLHttpRequest.prototype.open],
        ["XMLHttpRequest.send", XMLHttpRequest.prototype.send],
        ["JSON.parse", JSON.parse],
        ["Response.json", Response.prototype.json]
      ].filter(([, f]) => !isNative(f)).map(([n]) => n);
      weak = patched.length;
      if (weak) reasons.push("replaced functions: " + patched.join(", "));
    } catch (e) { christmasLog.debug("detector", e); }

    return { score, weak, reasons };
  }

  // ---------- Lock screen (cannot be closed) ----------
  const LOCK_ID = "christmas-lock-screen";
  const STORE_KEY = "christmas_sfc_locked";
  let locked = false;

  function buildLock(title, text) {
    const o = document.createElement("div");
    o.id = LOCK_ID;
    o.style.cssText = "position:fixed;inset:0;z-index:2147483647;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.8em;background:#000;color:#fff;font-family:sans-serif;text-align:center;padding:2em;cursor:not-allowed;user-select:none";
    const h = document.createElement("div");
    h.textContent = title || LOCK_TITLE;
    h.style.cssText = "font:800 clamp(28px,5vw,64px)/1.1 sans-serif;color:#ff3b3b";
    const p = document.createElement("div");
    p.textContent = text || LOCK_TEXT;
    p.style.cssText = "font:600 clamp(16px,2vw,24px)/1.3 sans-serif;color:#ddd;max-width:40em";
    o.append(h, p);
    return o;
  }

  // Stops the game from receiving keys / mouse while locked (reload and dev tools keys still work)
  const BLOCKED = ["keydown", "keyup", "keypress", "mousedown", "mouseup", "click", "dblclick", "contextmenu", "wheel", "mousemove", "pointerdown", "pointerup", "pointermove", "touchstart", "touchmove", "touchend"];
  function blockInput(e) {
    if (e.type === "keydown" || e.type === "keyup") {
      const k = (e.key || "").toLowerCase();
      if (k === "f5" || k === "f12" || ((e.ctrlKey || e.metaKey) && k === "r")) return;
    }
    e.stopImmediatePropagation();
    e.preventDefault();
  }

  function lock(reasons, score, kind) {
    if (locked) return true;
    if (!document.body) return false;
    locked = true;
    if (reasons) christmasLog.warn("detector", (kind === "skin" ? "skin hack" : "SFC") + " detected (score " + score + "): " + reasons.join("; "));
    try { if (PERSIST_LOCK) localStorage.setItem(STORE_KEY, "1"); } catch (e) { christmasLog.debug("detector", e); }

    const mount = () => {
      if (!document.getElementById(LOCK_ID) && document.body) document.body.appendChild(kind === "skin" ? buildLock(SKIN_LOCK_TITLE, SKIN_LOCK_TEXT) : buildLock());
      document.documentElement.style.overflow = "hidden";
      try { document.exitPointerLock(); } catch (e) { christmasLog.debug("detector", e); }
    };
    mount();
    BLOCKED.forEach((t) => window.addEventListener(t, blockInput, { capture: true, passive: false }));
    setInterval(mount, 250); // puts the screen back if someone deletes it
    return true;
  }

  function checkSelf() {
    if (locked) return;
    let remembered = false;
    try { remembered = PERSIST_LOCK && localStorage.getItem(STORE_KEY) === "1"; } catch (e) { christmasLog.debug("detector", e); }
    if (remembered) { lock(); return; }
    const { score, reasons } = findEvidence();
    if (score >= THRESHOLD) { lock(reasons, score); return; }
    if (SKIN_HACK_CHECK) {
      const skin = findSkinEvidence();
      if (skin.score >= SKIN_THRESHOLD) { lock(skin.reasons, skin.score, "skin"); return; }
      if ((skin.weak >= 2 || skin.score >= 2) && !skinWarned && warn(" Some game functions were modified. If you use a skin hack, turn it off.", "#c25b00", 12000)) {
        skinWarned = true;
        christmasLog.warn("detector", "possible skin hack tampering: " + skin.reasons.join("; "));
      }
    }
  }

  // ---------- 2. Do other players look like they use SFC? ----------
  const SIGNATURE = /state\s*farm|dsc\.gg\/sfnetwork|\[sfc\]|\bsfc\b/i;
  const SKIN_SIGNATURE = /skin\s*(hacks?|unlock(?:er)?|changer|spoof(?:er)?)|unlock\s*all\s*(skins|items|knives)|free\s*skins?/i;
  const doneChat = new WeakSet();
  const doneSkinChat = new WeakSet();
  const flagged = new Set();
  function flag(key, text) {
    if (flagged.has(key)) return;
    if (warn(text, "#c25b00", 12000)) { flagged.add(key); christmasLog.info("players", text.trim()); }
  }
  function checkOthers() {
    try {
      document.querySelectorAll("#chatOut .chat-item").forEach((el) => {
        if (doneChat.has(el)) return;
        doneChat.add(el);
        if (SIGNATURE.test(norm(el.textContent))) {
          const name = (el.querySelector(".chat-player-name")?.textContent || "A player").trim();
          flag("chat:" + name, ` ${name} sent an SFC message. Looks like StateFarm Client: use off hacks!`);
        }
      });
      if (SKIN_HACK_CHECK) {
        document.querySelectorAll("#chatOut .chat-item").forEach((el) => {
          if (doneSkinChat.has(el)) return;
          doneSkinChat.add(el);
          if (SKIN_SIGNATURE.test(norm(el.textContent))) {
            const name = (el.querySelector(".chat-player-name")?.textContent || "A player").trim();
            flag("skinchat:" + name, ` ${name} is talking about skin hacks. Skin hacks are cheating: turn them off!`);
          }
        });
        document.querySelectorAll("#playerList .playerSlot--name").forEach((el) => {
          const name = el.textContent.trim();
          if (name && SKIN_SIGNATURE.test(norm(name))) {
            flag("skinname:" + name, ` Player "${name}" has a skin hack style name. Skin hacks are cheating!`);
          }
        });
      }
      document.querySelectorAll("#playerList .playerSlot--name").forEach((el) => {
        const name = el.textContent.trim();
        if (name && SIGNATURE.test(norm(name))) {
          flag("name:" + name, ` Player "${name}" has an SFC-style name. Looks like StateFarm Client: use off hacks!`);
        }
      });
    } catch (e) { christmasLog.debug("detector", e); }
  }

  // ---------- Run ----------
  const scan = () => { checkSelf(); if (SCAN_OTHER_PLAYERS) checkOthers(); };
  scan();
  document.addEventListener("DOMContentLoaded", scan, { once: true });
  window.addEventListener("load", scan, { once: true });
  setInterval(scan, CHECK_EVERY_MS);

  let timer = null;
  const startObserver = () => new MutationObserver(() => {
    clearTimeout(timer);
    timer = setTimeout(scan, 300);
  }).observe(document.documentElement, { childList: true, subtree: true });
  document.documentElement ? startObserver() : document.addEventListener("DOMContentLoaded", startObserver, { once: true });
});
