  // Same mounting approach as Blossom V4: start on <html> so the loading screen is themed immediately,
  // then move to <body> so these rules win ties with the game's own stylesheets.
  const settle = () => document.body.appendChild(css);
  const mount = () => {
    document.documentElement.appendChild(css);
    document.body ? settle() : document.addEventListener("DOMContentLoaded", settle, { once: true });
  };
  document.documentElement ? mount() : new MutationObserver((_, o) => document.documentElement && (o.disconnect(), mount())).observe(document, { childList: true });
  // The browser tab is renamed too, and renamed back if the game changes it.
  const TITLE = "Christmas Theme by DST";
  const setTitle = () => { if (document.title !== TITLE) document.title = TITLE; };
  const watchTitle = () => {
    const t = document.querySelector("title");
    if (!t) return false;
    setTitle();
    new MutationObserver(setTitle).observe(t, { childList: true, characterData: true, subtree: true });
    return true;
  };
  if (!watchTitle()) {
    const o = new MutationObserver(() => { if (watchTitle()) o.disconnect(); });
    o.observe(document, { childList: true, subtree: true });
  }

  // ---------- Green grenade + ammo icons, found from the game's own stylesheet ----------
  // The HUD draws these icons as CSS backgrounds, so they cannot be matched by an <img> rule.
  // This reads the game's CSS, finds which selectors use ico_grenade / ico_ammo and recolours exactly those.
  const ICON_FILES = ["ico_grenade", "ico_ammo"];
  const ICON_GREEN = "grayscale(1) sepia(1) saturate(5) hue-rotate(65deg) brightness(.6) contrast(1.15) drop-shadow(1.5px 0 0 #000) drop-shadow(-1.5px 0 0 #000) drop-shadow(0 1.5px 0 #000) drop-shadow(0 -1.5px 0 #000)";
  const iconSeen = new Set();
  let iconStyle = null;
  const collectIcons = (rules, found) => {
    for (const r of rules) {
      try {
        if (r.cssRules && !r.selectorText) { collectIcons(r.cssRules, found); continue; } // @media / @supports
        if (!r.selectorText || !r.style) continue;
        const css = r.cssText;
        for (const f of ICON_FILES) {
          if (css.includes(f)) { found.push([f, r.selectorText]); }
        }
      } catch (e) {}
    }
  };
  const applyIcons = () => christmasLog.guard("icons", () => {
    const found = [];
    let blocked = 0;
    for (const sheet of document.styleSheets) {
      if (sheet.ownerNode && sheet.ownerNode.id === "xmas-style") continue;
      if (sheet.ownerNode && sheet.ownerNode.id === "xmas-icons") continue;
      try { collectIcons(sheet.cssRules, found); } catch (e) { blocked++; }
    }
    if (blocked) christmasLog.debug("icons", blocked + " stylesheet(s) could not be read (cross-origin)");
    const fresh = found.filter(([f, sel]) => !iconSeen.has(f + "|" + sel));
    if (!fresh.length) return;
    fresh.forEach(([f, sel]) => { iconSeen.add(f + "|" + sel); christmasLog.info("icons", f + " is used by: " + sel); });
    if (!iconStyle) {
      iconStyle = document.createElement("style");
      iconStyle.id = "xmas-icons";
      (document.body || document.documentElement).appendChild(iconStyle);
    }
    const sels = [...new Set([...iconSeen].map((k) => k.split("|").slice(1).join("|")))];
    iconStyle.textContent = sels.join(",\n") + " { filter: " + ICON_GREEN + " !important; }";
  });
  [0, 1500, 4000, 8000].forEach((ms) => setTimeout(applyIcons, ms));
  window.addEventListener("load", applyIcons, { once: true });
  setTimeout(() => {
    ICON_FILES.forEach((f) => {
      if (![...iconSeen].some((k) => k.startsWith(f + "|"))) christmasLog.warn("icons", "no stylesheet rule uses " + f + " (it may be an <img> or set by script)");
    });
  }, 9000);

  // Health check a few seconds after load: records a problem if the theme did not apply
  setTimeout(() => {
    try {
      if (!document.getElementById("xmas-style")) christmasLog.error("theme", "style tag is missing after load");
      else christmasLog.info("theme", "style tag present");
      const art = getComputedStyle(document.documentElement).getPropertyValue("--xm-art");
      if (!art || /PASTE_YOUR/.test(art)) christmasLog.error("theme", "background picture (--xm-art) is missing");
    } catch (e) { christmasLog.error("theme", e); }
  }, 4000);
});

