/* =====================================================================
   RUNTIME BUG LOG
   HOW TO READ THE LOG (open the browser console with F12 on the game page):
     christmasLog.show()   prints every entry as a table
     christmasLog.copy()   copies the whole log as text so you can send it
     christmasLog.clear()  empties the log
   Warnings and errors also print live as "[Christmas] ...". Debug and info entries are only stored.
   ===================================================================== */
(() => {
  "use strict";
  const MAX = 300;
  const entries = [];
  const seen = new Map();
  const stamp = () => new Date().toISOString().slice(11, 19);
  const asText = (m) => {
    if (m instanceof Error) return (m.stack ? m.stack.split("\n").slice(0, 3).join(" | ") : m.message);
    if (typeof m === "string") return m;
    try { return JSON.stringify(m); } catch (e) { return String(m); }
  };
  function add(level, source, msg) {
    const body = asText(msg);
    const key = level + "|" + source + "|" + body;
    const n = (seen.get(key) || 0) + 1;
    seen.set(key, n);
    if (n > 1) { // same message again: just count it
      const last = entries.find((e) => e.key === key);
      if (last) { last.count = n; last.time = stamp(); }
      return;
    }
    entries.push({ key, time: stamp(), level, source, msg: body, count: 1 });
    if (entries.length > MAX) seen.delete(entries.shift().key);
    if (level === "warn") console.warn("[Christmas] " + source + ": " + body);
    else if (level === "error") console.error("[Christmas] " + source + ": " + body);
  }
  const api = {
    entries,
    debug: (src, msg) => add("debug", src, msg),
    info: (src, msg) => add("info", src, msg),
    warn: (src, msg) => add("warn", src, msg),
    error: (src, msg) => add("error", src, msg),
    // Runs a function and records any crash instead of letting it fail silently
    guard(name, fn) { try { fn(); } catch (e) { add("error", name, e); } },
    text() {
      return entries.map((e) => e.time + " [" + e.level + "] " + e.source + (e.count > 1 ? " x" + e.count : "") + ": " + e.msg).join("\n");
    },
    show() {
      console.table(entries.map((e) => ({ time: e.time, level: e.level, source: e.source, count: e.count, message: e.msg })));
      return entries.length + " entries";
    },
    copy() {
      const t = api.text();
      try { navigator.clipboard.writeText(t); return "copied " + entries.length + " entries"; } catch (e) { return t; }
    },
    clear() { entries.length = 0; seen.clear(); return "cleared"; }
  };
  window.christmasLog = api;
  api.info("log", "Christmas script started on " + location.hostname);
})();

